# ── Application ──────────────────────────────────────────
HOST=0.0.0.0
PORT=3333
APP_KEY=
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3333
SESSION_DRIVER=cookie

# ── Database ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=adonisjs_tutorial

# ── Authentication ────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=7d

# ── Hashing ───────────────────────────────────────────────
HASH_DRIVER=argon

# ── Rate limiting ─────────────────────────────────────────
LIMITER_STORE=database
THROTTLE_AUTH_MAX=10
THROTTLE_AUTH_WINDOW=60
